{
  "manifest_version": 3,
  "name": "YouTube Face Blur",
  "version": "1.1.0",
  "description": "Automatically blurs the video on YouTube whenever a face of the chosen gender is detected on screen.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://*.hotstar.com/*",
    "https://*.jiohotstar.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://*.hotstar.com/*",
        "https://*.jiohotstar.com/*"
      ],
      "js": ["lib/face-api.min.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["models/*"],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://*.hotstar.com/*",
        "https://*.jiohotstar.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Face Blur"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "face-blur@example.com",
      "strict_min_version": "109.0"
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  }
}
